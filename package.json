{
  "name": "enterprise-playwright-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + TypeScript test automation framework for UI and API testing across any web application",
  "author": "Quality Engineering Lead & Automation Architecture Team",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "clean": "bash scripts/clean-artifacts.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,tests,configs,docs}/**/*.{ts,js,json,md,yml}\"",
    "format:check": "prettier --check \"{src,tests,configs,docs}/**/*.{ts,js,json,md,yml}\"",
    "test": "cross-env TEST_ENV=local playwright test",
    "test:ui": "cross-env TEST_ENV=local playwright test --project=chromium --grep \"@ui\"",
    "test:api": "cross-env TEST_ENV=local playwright test --project=api --grep \"@api\"",
    "test:smoke": "cross-env TEST_ENV=local playwright test --project=chromium --grep \"@smoke\"",
    "test:regression": "cross-env TEST_ENV=local playwright test --project=chromium --grep \"@regression\"",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test --grep \"@sanity\"",
    "test:headed": "cross-env TEST_ENV=local playwright test --headed",
    "test:debug": "cross-env TEST_ENV=local playwright test --debug",
    "report:html": "playwright show-report reports/playwright-html",
    "report:allure:generate": "allure generate allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report",
    "report:allure:serve": "allure serve allure-results",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@faker-js/faker": "^9.5.0",
    "axios": "^1.8.1",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "allure-commandline": "^2.32.2",
    "allure-playwright": "^3.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-playwright": "^2.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
