# UAT Environment Configuration
TEST_ENV=uat
BASE_URL=https://uat.saucedemo.com
API_BASE_URL=https://reqres.in/api

HEADLESS=true
BROWSER=chromium
WORKERS=3
RETRIES=1
TIMEOUT=40000
EXPECT_TIMEOUT=12000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=40000

LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs

ADMIN_USERNAME=uat_admin_user
ADMIN_PASSWORD=uat_secret_sauce
STANDARD_USERNAME=uat_standard_user
STANDARD_PASSWORD=uat_secret_sauce

AUTH_TYPE=bearer
AUTH_TOKEN=uat_bearer_token_xyz
API_KEY=uat_api_key_abc
AUTH_CLIENT_ID=enterprise_client_uat
AUTH_CLIENT_SECRET=enterprise_client_secret_uat
AUTH_TOKEN_URL=https://reqres.in/api/login

GENERATE_ALLURE=true
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
TAKE_SCREENSHOT=only-on-failure
