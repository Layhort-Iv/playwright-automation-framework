# Production Environment Configuration (Read-only / Sanity checks only)
TEST_ENV=prod
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://reqres.in/api

HEADLESS=true
BROWSER=chromium
WORKERS=2
RETRIES=1
TIMEOUT=45000
EXPECT_TIMEOUT=15000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000

LOG_LEVEL=warn
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs

ADMIN_USERNAME=standard_user
ADMIN_PASSWORD=secret_sauce
STANDARD_USERNAME=standard_user
STANDARD_PASSWORD=secret_sauce

AUTH_TYPE=apikey
AUTH_TOKEN=prod_bearer_token_xyz
API_KEY=reqres-free-v1
AUTH_CLIENT_ID=enterprise_client_prod
AUTH_CLIENT_SECRET=enterprise_client_secret_prod
AUTH_TOKEN_URL=https://reqres.in/api/login

GENERATE_ALLURE=true
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
TAKE_SCREENSHOT=only-on-failure
