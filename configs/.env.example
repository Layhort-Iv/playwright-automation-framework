# ==============================================================================
# Enterprise Playwright Automation Framework - Environment Configuration Template
# ==============================================================================

# Execution Environment: local | dev | qa | uat | staging | prod
TEST_ENV=local

# Base Application URLs
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://reqres.in/api

# Execution Settings
HEADLESS=true
BROWSER=chromium
WORKERS=2
RETRIES=1
TIMEOUT=30000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# Logging & Observability
LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs

# Security & Credentials (Masked in logs)
ADMIN_USERNAME=standard_user
ADMIN_PASSWORD=secret_sauce
STANDARD_USERNAME=standard_user
STANDARD_PASSWORD=secret_sauce

# API Authentication (Pluggable Strategy)
AUTH_TYPE=bearer
AUTH_TOKEN=mock_bearer_token_12345
API_KEY=mock_api_key_secret_67890
AUTH_CLIENT_ID=enterprise_client_id
AUTH_CLIENT_SECRET=enterprise_client_secret
AUTH_TOKEN_URL=https://reqres.in/api/login

# Reporting Options
GENERATE_ALLURE=true
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
TAKE_SCREENSHOT=only-on-failure
