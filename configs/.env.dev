# Development Environment Configuration
TEST_ENV=dev
BASE_URL=https://dev.saucedemo.com
API_BASE_URL=https://reqres.in/api

HEADLESS=true
BROWSER=chromium
WORKERS=4
RETRIES=1
TIMEOUT=35000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=35000

LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs

ADMIN_USERNAME=dev_admin_user
ADMIN_PASSWORD=dev_secret_sauce
STANDARD_USERNAME=dev_standard_user
STANDARD_PASSWORD=dev_secret_sauce

AUTH_TYPE=bearer
AUTH_TOKEN=dev_bearer_token_xyz
API_KEY=dev_api_key_abc
AUTH_CLIENT_ID=enterprise_client_dev
AUTH_CLIENT_SECRET=enterprise_client_secret_dev
AUTH_TOKEN_URL=https://reqres.in/api/login

GENERATE_ALLURE=true
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
TAKE_SCREENSHOT=only-on-failure
