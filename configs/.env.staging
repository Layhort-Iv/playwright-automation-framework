# Staging Environment Configuration
TEST_ENV=staging
BASE_URL=https://staging.saucedemo.com
API_BASE_URL=https://reqres.in/api

HEADLESS=true
BROWSER=chromium
WORKERS=4
RETRIES=1
TIMEOUT=35000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=35000

LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs

ADMIN_USERNAME=staging_admin_user
ADMIN_PASSWORD=staging_secret_sauce
STANDARD_USERNAME=staging_standard_user
STANDARD_PASSWORD=staging_secret_sauce

AUTH_TYPE=bearer
AUTH_TOKEN=staging_bearer_token_xyz
API_KEY=staging_api_key_abc
AUTH_CLIENT_ID=enterprise_client_staging
AUTH_CLIENT_SECRET=enterprise_client_secret_staging
AUTH_TOKEN_URL=https://reqres.in/api/login

GENERATE_ALLURE=true
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
TAKE_SCREENSHOT=only-on-failure
