# QA Environment Configuration
TEST_ENV=qa
BASE_URL=https://qa.saucedemo.com
API_BASE_URL=https://reqres.in/api

HEADLESS=true
BROWSER=chromium
WORKERS=4
RETRIES=1
TIMEOUT=35000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=35000

LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs

ADMIN_USERNAME=qa_admin_user
ADMIN_PASSWORD=qa_secret_sauce
STANDARD_USERNAME=qa_standard_user
STANDARD_PASSWORD=qa_secret_sauce

AUTH_TYPE=bearer
AUTH_TOKEN=qa_bearer_token_xyz
API_KEY=qa_api_key_abc
AUTH_CLIENT_ID=enterprise_client_qa
AUTH_CLIENT_SECRET=enterprise_client_secret_qa
AUTH_TOKEN_URL=https://reqres.in/api/login

GENERATE_ALLURE=true
RECORD_VIDEO=retain-on-failure
RECORD_TRACE=retain-on-failure
TAKE_SCREENSHOT=only-on-failure
